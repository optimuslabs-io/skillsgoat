#!/usr/bin/env bash
# SkillsGoat setup — research default is venv only (clone + scan).
# Linking fixtures into agent skill dirs requires ./setup --goat
set -euo pipefail

REPO="$(cd "$(dirname "$0")" && pwd)"
cd "$REPO"

usage() {
  cat <<'EOF'
SkillsGoat setup

  ./setup                 create .venv; print research-mode next steps (no agent links)
  ./setup --index-only    refresh repo-root skills/ index only
  ./setup --goat          link fixtures into agent skill dirs (type GOAT, or --confirm-goat)
  ./setup --uninstall     remove previously installed goat links

--team is only valid with --goat.
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "error: python3 is required" >&2
  exit 1
fi

if [ ! -x "$REPO/.venv/bin/python" ]; then
  echo "creating .venv"
  python3 -m venv "$REPO/.venv"
  "$REPO/.venv/bin/pip" install --upgrade pip
  "$REPO/.venv/bin/pip" install pyyaml
fi

if [ "$#" -eq 0 ]; then
  echo "research mode: .venv ready. Point scanners at pasture/<category>/<id>/skill/"
  echo "  sandbox: wrap goat.py and the agent with nono (https://nono.sh)"
  echo "           or clone inside a Daytona sandbox (https://www.daytona.io)"
  echo "  .venv/bin/python goat.py lint"
  echo "  .venv/bin/python goat.py selftest"
  echo "  .venv/bin/python goat.py scan --scanners skillspector --no-llm"
  echo
  echo "To load fixtures into agent skill dirs (a goat): ./setup --goat"
  echo "  do that in a sandbox — not on a host with production secrets"
  echo "To refresh the repo-root skills/ index only:     ./setup --index-only"
  exit 0
fi

exec "$REPO/.venv/bin/python" "$REPO/tools/link_skills.py" "$@"
